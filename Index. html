    }

    .search-section{
        padding:0 15px;
    }

    .search-box{
        flex-direction:column;
    }

    .search-box button{
        width:100%;
    }

    .quick-section,
    .updates,
    .skills,
    .featured{
        padding:15px;
    }

    .quick-actions{
        grid-template-columns:1fr 1fr;
    }

}


/* =========================
