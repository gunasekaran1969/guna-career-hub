<title>Guna Career Hub | Jobs, Courses & Career Guidance</title>

<style>

/* =========================
   BASIC
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f4f7fb;
    color:#222;
    padding-bottom:75px;
}


/* =========================
   HEADER
========================= */

header{
    background:linear-gradient(135deg,#123c8c,#1976d2);
    color:white;
    text-align:center;
    padding:30px 15px;
}

header h1{
    font-size:30px;
    margin-bottom:8px;
}

header p{
    font-size:15px;
}


/* =========================
   NAVIGATION
========================= */

.navbar{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    background:#0b2d6b;
}

.navbar a{
    color:white;
    text-decoration:none;
    padding:13px 12px;
    font-size:14px;
}

.navbar a:hover{
    background:#1976d2;
}


/* =========================
   HERO
========================= */

.hero{
    text-align:center;
    padding:55px 20px;
    color:white;
    background:linear-gradient(135deg,#1976d2,#42a5f5);
}

.hero-content{
    max-width:800px;
    margin:auto;
}

.hero-badge{
    display:inline-block;
    background:rgba(255,255,255,0.18);
    padding:8px 16px;
    border-radius:25px;
    font-size:14px;
    margin-bottom:15px;
}

.hero h2{
    font-size:34px;
    margin-bottom:15px;
}

.hero p{
    max-width:700px;
    margin:auto;
    line-height:1.6;
    font-size:17px;
}

.hero-buttons{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
    margin-top:25px;
}

.hero-button{
    display:inline-block;
    padding:13px 28px;
    background:white;
    color:#123c8c;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
}

.hero-button:hover{
    transform:translateY(-2px);
}

.hero-button.secondary{
    background:#123c8c;
    color:white;
}


/* =========================
   SEARCH
========================= */

.search-section{
    max-width:800px;
    margin:-25px auto 20px;
    padding:0 20px;
    position:relative;
    z-index:10;
}

.search-box{
    background:white;
    padding:15px;
    border-radius:18px;
    box-shadow:0 6px 20px rgba(0,0,0,.15);
    display:flex;
    gap:10px;
}

.search-box input{
    flex:1;
    padding:13px;
    border:1px solid #ddd;
    border-radius:10px;
    font-size:15px;
    outline:none;
}

.search-box button{
    padding:13px 20px;
    border:none;
    border-radius:10px;
    background:#123c8c;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.search-box button:hover{
    background:#1976d2;
}


/* =========================
   SECTION TITLE
========================= */

.section-title{
    text-align:center;
    padding:30px 15px 10px;
}

.section-title h2{
    color:#123c8c;
}

.section-title p{
    margin-top:8px;
    color:#666;
}


/* =========================
   CARDS
========================= */

.container{
    max-width:1100px;
    margin:auto;
    padding:20px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:20px;
}

.card{
    display:block;
    background:white;
    padding:25px 20px;
    border-radius:18px;
    box-shadow:0 5px 15px rgba(0,0,0,.12);
    text-align:center;
    text-decoration:none;
    color:#333;
    transition:.25s;
    border:1px solid #e5e7eb;
}

.card:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 22px rgba(0,0,0,.18);
}

.icon{
    font-size:42px;
    margin-bottom:12px;
}

.card h3{
    color:#123c8c;
    margin-bottom:10px;
    font-size:21px;
}

.card p{
    color:#666;
    line-height:1.5;
    font-size:14px;
}


/* =========================
   QUICK ACTIONS
========================= */

.quick-section{
    max-width:1100px;
    margin:20px auto;
    padding:20px;
}

.quick-box{
    background:white;
    border-radius:18px;
    padding:25px;
    box-shadow:0 5px 15px rgba(0,0,0,.10);
}

.quick-box h2{
    color:#123c8c;
    text-align:center;
    margin-bottom:20px;
}

.quick-actions{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.quick-action{
    padding:15px;
    background:#eef5ff;
    border-radius:12px;
    text-align:center;
    text-decoration:none;
    color:#123c8c;
    font-weight:bold;
}

.quick-action:hover{
    background:#dbeafe;
}


/* =========================
   LATEST UPDATES
========================= */

.updates{
    max-width:1100px;
    margin:20px auto;
    padding:20px;
}

.updates-box{
    background:white;
    border-radius:18px;
    padding:25px;
    box-shadow:0 5px 15px rgba(0,0,0,.10);
}

.updates-box h2{
    color:#123c8c;
    margin-bottom:15px;
}

.update{
    padding:13px 0;
    border-bottom:1px solid #eee;
}

.update:last-child{
    border-bottom:none;
}

.update strong{
    color:#123c8c;
}

.update span{
    color:#666;
    font-size:14px;
}


/* =========================
   POPULAR SKILLS
========================= */

.skills{
    max-width:1100px;
    margin:20px auto;
    padding:20px;
}

.skills-box{
    background:white;
    border-radius:18px;
    padding:25px;
    box-shadow:0 5px 15px rgba(0,0,0,.10);
    text-align:center;
}

.skills-box h2{
    color:#123c8c;
    margin-bottom:18px;
}

.skill{
    display:inline-block;
    padding:9px 15px;
    margin:5px;
    background:#e3f2fd;
    color:#123c8c;
    border-radius:20px;
    font-size:14px;
    font-weight:bold;
}


/* =========================
   FEATURED
========================= */

.featured{
    max-width:1100px;
    margin:20px auto;
    padding:20px;
}

.featured-box{
    background:linear-gradient(135deg,#123c8c,#1976d2);
    color:white;
    border-radius:18px;
    padding:30px;
    text-align:center;
    box-shadow:0 5px 15px rgba(0,0,0,.15);
}

.featured-box h2{
    margin-bottom:12px;
}

.featured-box p{
    line-height:1.6;
    max-width:750px;
