<script>

/* =========================
   SEARCH FUNCTION
========================= */

function searchCareer(){

    let search =
        document.getElementById("careerSearch")
        .value
        .toLowerCase()
        .trim();

    if(search === ""){
        alert("Please enter something to search.");
        return;
    }


    if(
        search.includes("job") ||
        search.includes("jobs") ||
        search.includes("work")
    ){

        window.location.href="jobs.html";

    }

    else if(
        search.includes("course") ||
        search.includes("learn") ||
        search.includes("skill") ||
        search.includes("sql") ||
        search.includes("excel") ||
        search.includes("python") ||
        search.includes("ai")
    ){

        window.location.href="courses.html";

    }

    else if(
        search.includes("exam") ||
        search.includes("tnpsc") ||
        search.includes("ssc") ||
        search.includes("railway") ||
        search.includes("bank")
    ){

        window.location.href="exams.html";

    }

    else if(
        search.includes("resume") ||
        search.includes("cv")
    ){

        window.location.href="resume.html";

    }

    else if(
        search.includes("quiz") ||
        search.includes("test")
    ){

        window.location.href="quiz.html";

    }

    else if(
        search.includes("tool") ||
        search.includes("calculator") ||
        search.includes("percentage") ||
        search.includes("salary") ||
        search.includes("age") ||
        search.includes("cgpa")
    ){

        window.location.href="tools.html";

    }

    else{

        alert(
            "No matching section found. Try Jobs, Courses, Exams, Resume, Quiz or Tools."
        );

    }

}


/* ENTER KEY SEARCH */

document.getElementById("careerSearch")
.addEventListener("keypress",function(event){

    if(event.key === "Enter"){

        searchCareer();

    }

});

</script>


