/* =========================
   MOBILE BOTTOM NAV
========================= */

.bottom-nav{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    display:flex;
    justify-content:space-around;
    background:#123c8c;
    padding:9px 5px;
    z-index:1000;
    box-shadow:0 -3px 10px rgba(0,0,0,.2);
}

.bottom-nav a{
    color:white;
    text-decoration:none;
    text-align:center;
    font-size:11px;
}

.bottom-nav span{
    display:block;
    font-size:19px;
    margin-bottom:2px;
}


/* =========================
   MOBILE
========================= */

@media(max-width:700px){

    header h1{
        font-size:25px;
    }

    .navbar{
        display:none;
    }

    .hero{
        padding:42px 18px;
    }

    .hero h2{
        font-size:27px;
    }

    .hero p{
        font-size:15px;
    }

    .container{
        grid-template-columns:1fr;
